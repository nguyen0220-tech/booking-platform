scalar BigDecimal

extend type Query{
    facility(id:ID!):Facility
    facilities(page:Int!, size:Int!):ListFacility
    facilitiesByKeyword(keyword:String!, page:Int!, size:Int!):ListFacility
}

type ListFacility{
    data:[Facility]
    pageInfo:PageInfo
}

type Facility{
    id:ID!
    facilityType:String!
    ownerId:ID!
    facilityRegistrationId:ID
    facilityInfo:FacilityInfo!
    imageUrls:[String]
    facilityTarget:FacilityTarget
    owner:User
    approvalStatus:FacilityApproval
    packages(page:Int!, size:Int!):ListPackage
    reviews(page:Int!, size:Int!):ListReview
    ratingGroupBy:[ReviewGroupBy]
}

type FacilityInfo{
    name:String!
    description:String!
    address:String!
    instruction:String
    averageRating:Float!
    totalReviews:Int!
    active:Boolean!
    carPark:Boolean!
    hasWifi:Boolean!
    isSuspended:Boolean!
    createdAt:String!
    updatedAt:String!
}

union FacilityTarget = Sport | Motel | Restaurant

type Sport{
    hourPrice:BigDecimal!
}

type Motel{
    nightPrice:BigDecimal!
    hourPrice:BigDecimal!
}

type Restaurant{
    foodType:String!
    openTime:String!
    closeTime:String!
    menus:[RestaurantMenu]
}

type RestaurantMenu{
    id:ID!,
    name:String!,
    description:String,
    price:BigDecimal!
    imageUrl:String
    deleted:Boolean!
    soldOut:Boolean!
}

type FacilityApproval{
    status:String!
    note:String
    lastUpdateAt:String!
}
